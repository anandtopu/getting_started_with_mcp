# Offline default; no API key or model download required.
LLM_PROVIDER=fake
LLM_MODEL=fixture
# Change BOTH variables for a real model. Verified 2026-10-29:
# ollama: qwen3:4b (first run: ollama pull qwen3:4b)
# anthropic: claude-haiku-5-5
# openai: gpt-6-luna
# gemini: gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512
# Optional absolute checkout path when running an installed wheel elsewhere:
# LUMEN_REPO_ROOT=

{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "common/typescript/**/*.ts",
    "modules/**/typescript/**/*.ts",
    "scripts/*.ts",
    "distribution/npm/src/*.ts"
  ]
}

{
  "name": "getting-started-with-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "common/typescript",
    "modules/*/typescript"
  ],
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "test": "vitest run --maxWorkers=4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint common/typescript modules scripts/check-exercise.ts scripts/check-ts-extension-exercise.ts scripts/typescript_*.ts distribution/npm/src tests/browser playwright*.config.ts common/web_ui/app.source.js scripts/build_notes.mjs scripts/build_web_chat.mjs scripts/bundle_licenses.mjs",
    "inspector": "mcp-inspector",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:dashboard": "node scripts/build_dashboard.mjs",
    "build:notes": "node scripts/build_notes.mjs",
    "mcpb": "mcpb",
    "build:chat": "node scripts/build_web_chat.mjs",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:browser:typescript": "playwright test --config playwright.typescript.config.ts",
    "chat:typescript": "node --import tsx scripts/typescript_chat.ts",
    "gateway:typescript": "node --import tsx scripts/typescript_gateway.ts",
    "test:deployment:typescript": "node --import tsx scripts/typescript_deployment_check.ts"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "~10.0.1",
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.5.3",
    "@modelcontextprotocol/client": "~2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/inspector": "~2.13.0",
    "@modelcontextprotocol/server": "~2.4.0",
    "@modelcontextprotocol/server-filesystem": "2.1.0",
    "@openai/agents": "0.21.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "~26.6.6",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "~10.13.0",
    "tsx": "~4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vitest": "~5.0.5",
    "zod": "~4.6.7"
  },
  "overrides": {
    "tmp": ">=0.2.6 <0.3"
  }
}
